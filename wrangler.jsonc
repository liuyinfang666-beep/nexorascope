{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexorascope-security-api-preview",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-20",
  "previews": {},
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
